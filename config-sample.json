{
  "qbittorrent": {
    "url": "http://127.0.0.1:8080/",
    "username": "your_username",
    "password": "your_password"
  },
  "paths": {
    "watch_dir": "/path/to/watch_dir",
    "completed_dir": "/path/to/completed_dir",
    "local_save_path": "/path/to/qbittorrent_local_downloads/",
    "remote_save_path": "/path/to/rclone_fuse_mount/",
    "category": "SSD",
    "remote_category": "remote"
  },
  "settings": {
    "ssd_limit_gb": 35.0,
    "wait_time_minutes": 2,
    "poll_interval_seconds": 10,
    "fuse_cooldown_seconds": 15,
    "max_active_downloads": 3
  },
  "rclone": {
    "remote": "remote_name:path/",
    "transfers": 2,
    "max_parallel_jobs": 2
  },
  "telegram": {
    "enabled": false,
    "bot_token": "YOUR_TELEGRAM_BOT_TOKEN",
    "chat_id": "YOUR_TELEGRAM_CHAT_ID",
    "oversized_chat_id": "YOUR_OVERSIZED_CHAT_ID",
    "not_found_chat_id": "YOUR_NOT_FOUND_CHAT_ID"
  },
  "racing_qbittorrent": {
    "url": "http://127.0.0.1:8081/",
    "username": "your_racing_username",
    "password": "your_racing_password"
  },
  "prowlarr": {
    "url": "http://127.0.0.1:9696/",
    "api_key": "YOUR_PROWLARR_API_KEY",
    "indexer_name": "local"
  },
  "racing_settings": {
    "poll_interval_seconds": 60,
    "tracker_filter": "tracker_domain.com",
    "max_search_age_hours": 24,
    "search_interval_minutes": 15,
    "search_gap_seconds": 180,
    "completed_category": "processed"
  }
}
